{
  "mcpServers": {
    "anstar-business-central": {
      "command": "npx",
      "args": ["-y", "tsx@4.23.13", "./scripts/bootstrap.ts"],
      "cwd": ".",
      "enabled": false,
      "enabled_tools": [
        "bc_connect",
        "bc_status",
        "bc_actions_search",
