{
  "mcpServers": {
    "ms365": {
      "command": "cmd",
      "args": [
        "/d",
        "/s",
        "/c",
        "scripts\\start-ms365.cmd"
      ],
      "cwd": ".",
      "env": {
        "ENABLED_TOOLS": "^(?!.*adhoc-call-transcript).*$"
      },
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 120,
      "default_tools_approval_mode": "writes"
    }
  }
}
